{
  "schemaVersion": 1,
  "$defs": {
    "empty": {"type": "object", "additionalProperties": false},
    "levelId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "collectionState": {"enum": ["unknown", "complete", "partial"]},
    "archive": {"type": "object", "required": ["schema_version", "level", "updated_at", "fetch_count", "last_pages", "collection_state", "collection_message", "last_new_counts", "comments"], "additionalProperties": true},
    "archiveOverview": {"type": "object", "required": ["level", "updated_at", "fetch_count", "last_pages", "collection_state", "collection_message", "comment_count"], "properties": {"level": {"type": "object"}, "updated_at": {"type": "integer", "minimum": 0}, "fetch_count": {"type": "integer", "minimum": 0}, "last_pages": {"type": "integer", "minimum": 0}, "collection_state": {"$ref": "#/$defs/collectionState"}, "collection_message": {"type": "string", "maxLength": 2048}, "comment_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "fullComment": {"type": "object", "required": ["reply_id", "floor_id", "uid", "nickname", "avatar_url", "content", "is_recommend", "is_owner", "like_count", "reply_count", "created_at", "ip_region", "is_sub", "parent_id", "reply_to"], "additionalProperties": true},
    "commentGroup": {"type": "object", "required": ["main", "subs"], "properties": {"main": {"$ref": "#/$defs/fullComment"}, "subs": {"type": "array", "items": {"$ref": "#/$defs/fullComment"}}}, "additionalProperties": false},
    "archiveViewPage": {"type": "object", "required": ["overview", "total_groups", "offset", "groups"], "properties": {"overview": {"$ref": "#/$defs/archiveOverview"}, "total_groups": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0}, "groups": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/commentGroup"}}}, "additionalProperties": false},
    "newCommentCounts": {"type": "object", "required": ["recommended", "not_recommended"], "properties": {"recommended": {"type": "integer", "minimum": 0}, "not_recommended": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "summary": {"type": "object", "required": ["level_id", "level_name", "cover_url", "updated_at", "count", "collection_state", "needs_recollect", "last_new_counts"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "level_name": {"type": "string", "maxLength": 512}, "cover_url": {"type": "string", "maxLength": 4096}, "updated_at": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 0}, "collection_state": {"$ref": "#/$defs/collectionState"}, "needs_recollect": {"type": "boolean"}, "last_new_counts": {"oneOf": [{"$ref": "#/$defs/newCommentCounts"}, {"type": "null"}]}}, "additionalProperties": false},
    "favoriteLevel": {"type": "object", "required": ["level_id", "level_name", "cover_url", "added_at"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "level_name": {"type": "string", "maxLength": 512}, "cover_url": {"type": "string", "maxLength": 4096}, "added_at": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "serviceSummary": {"type": "object", "required": ["level_id", "level_name", "updated_at", "count"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "level_name": {"type": "string", "maxLength": 512}, "updated_at": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "serviceComment": {"type": "object", "required": ["floor_id", "nickname", "content", "is_recommend", "like_count", "reply_count", "created_at", "is_sub", "reply_to"], "properties": {"floor_id": {"type": "string", "maxLength": 32}, "nickname": {"type": "string", "maxLength": 512}, "content": {"type": "string", "maxLength": 20000}, "is_recommend": {"type": ["boolean", "null"]}, "like_count": {"type": "integer", "minimum": 0}, "reply_count": {"type": "integer", "minimum": 0}, "created_at": {"type": "integer"}, "is_sub": {"type": "boolean"}, "reply_to": {"type": "string", "maxLength": 512}}, "additionalProperties": false},
    "servicePage": {"type": "object", "required": ["level_id", "level_name", "updated_at", "total_count", "offset", "comments"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "level_name": {"type": "string", "maxLength": 512}, "updated_at": {"type": "integer", "minimum": 0}, "total_count": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0}, "comments": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/serviceComment"}}}, "additionalProperties": false},
    "collectionMode": {"enum": ["full", "incremental"]},
    "monitorConfig": {"type": "object", "required": ["enabled", "level_ids", "incremental_interval_secs", "full_interval_secs", "max_parallel", "request_interval_ms", "overlap_pages", "incremental_max_pages"], "properties": {"enabled": {"type": "boolean"}, "level_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/levelId"}}, "incremental_interval_secs": {"type": "integer", "minimum": 60, "maximum": 86400}, "full_interval_secs": {"type": "integer", "minimum": 300, "maximum": 2592000}, "max_parallel": {"type": "integer", "minimum": 1, "maximum": 4}, "request_interval_ms": {"type": "integer", "minimum": 250, "maximum": 60000}, "overlap_pages": {"type": "integer", "minimum": 1, "maximum": 10}, "incremental_max_pages": {"type": "integer", "minimum": 1, "maximum": 500}}, "additionalProperties": false},
    "monitorLevelStatus": {"type": "object", "required": ["level_id", "running", "last_attempt_at", "last_success_at", "last_full_success_at", "consecutive_failures", "last_error", "last_mode", "next_collect_at"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "running": {"type": "boolean"}, "last_attempt_at": {"type": "integer", "minimum": 0}, "last_success_at": {"type": "integer", "minimum": 0}, "last_full_success_at": {"type": "integer", "minimum": 0}, "consecutive_failures": {"type": "integer", "minimum": 0}, "last_error": {"type": "string", "maxLength": 2048}, "last_mode": {"enum": ["full", "incremental", null]}, "needs_full_recovery": {"type": "boolean"}, "next_collect_at": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false},
    "monitorStatus": {"type": "object", "required": ["config", "levels"], "properties": {"config": {"$ref": "#/$defs/monitorConfig"}, "levels": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/monitorLevelStatus"}}}, "additionalProperties": false}
  },
  "methods": {
    "archives": {"params": {"$ref": "#/$defs/empty"}, "result": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/summary"}}, "timeoutMs": 10000},
    "favorites": {"params": {"$ref": "#/$defs/empty"}, "result": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/favoriteLevel"}}, "timeoutMs": 10000},
    "favorite_toggle": {"params": {"type": "object", "required": ["level_id"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}}, "additionalProperties": false}, "result": {"type": "boolean"}, "timeoutMs": 10000},
    "service_archives": {"params": {"$ref": "#/$defs/empty"}, "result": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/serviceSummary"}}, "timeoutMs": 10000},
    "archive_page": {"params": {"type": "object", "required": ["level_id", "offset", "limit"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "offset": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false}, "result": {"oneOf": [{"$ref": "#/$defs/servicePage"}, {"type": "null"}]}, "timeoutMs": 10000},
    "archive_view": {"params": {"type": "object", "required": ["level_id", "offset", "limit", "filter", "sort", "keyword"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "offset": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}, "filter": {"enum": ["all", "recommend", "notRecommend", "owner"]}, "sort": {"enum": ["default", "newest", "oldest", "likes", "floor"]}, "keyword": {"type": "string", "maxLength": 512}}, "additionalProperties": false}, "result": {"oneOf": [{"$ref": "#/$defs/archiveViewPage"}, {"type": "null"}]}, "timeoutMs": 30000},
    "collect": {"params": {"type": "object", "required": ["query"], "properties": {"query": {"type": "object", "required": ["level_id"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}}, "additionalProperties": false}}, "additionalProperties": false}, "result": {"$ref": "#/$defs/archiveOverview"}, "timeoutMs": 86400000},
    "export": {"params": {"type": "object", "required": ["level_id", "format"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "format": {"enum": ["json", "csv", "excel"]}}, "additionalProperties": false}, "result": {"type": "object", "required": ["path", "format", "rows"], "additionalProperties": true}, "timeoutMs": 30000},
    "export_dir": {"params": {"$ref": "#/$defs/empty"}, "result": {"type": "string", "maxLength": 1024}, "timeoutMs": 5000},
    "reveal_dir": {"params": {"$ref": "#/$defs/empty"}, "result": {"type": "object"}, "timeoutMs": 5000},
    "monitor_add": {"params": {"type": "object", "required": ["level_id"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}}, "additionalProperties": false}, "result": {"$ref": "#/$defs/monitorConfig"}, "timeoutMs": 10000},
    "monitor_remove": {"params": {"type": "object", "required": ["level_id"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}}, "additionalProperties": false}, "result": {"$ref": "#/$defs/monitorConfig"}, "timeoutMs": 10000},
    "monitor_config": {"params": {"$ref": "#/$defs/empty"}, "result": {"$ref": "#/$defs/monitorConfig"}, "timeoutMs": 10000},
    "monitor_configure": {"params": {"type": "object", "required": ["config"], "properties": {"config": {"$ref": "#/$defs/monitorConfig"}}, "additionalProperties": false}, "result": {"$ref": "#/$defs/monitorConfig"}, "timeoutMs": 10000},
    "monitor_status": {"params": {"$ref": "#/$defs/empty"}, "result": {"$ref": "#/$defs/monitorStatus"}, "timeoutMs": 10000},
    "monitor_run": {"params": {"type": "object", "required": ["level_id", "mode"], "properties": {"level_id": {"$ref": "#/$defs/levelId"}, "mode": {"$ref": "#/$defs/collectionMode"}}, "additionalProperties": false}, "result": {"type": "null"}, "timeoutMs": 10000}
  },
  "events": {"collect.progress": {"payload": {"type": "object", "required": ["page", "fetched"], "properties": {"page": {"type": "integer", "minimum": 0}, "fetched": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}}
}
